# Auto-HTTPS via Let's Encrypt. DOMAIN and ACME_EMAIL come from env vars set in Coolify.
{
        email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
        encode gzip zstd

        @www host www.{$DOMAIN}
        redir @www https://{$DOMAIN}{uri} permanent

        handle /api/* {
                reverse_proxy api-server:8080 {
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-For  {remote}
                        header_up Host             {host}
                }
        }
        handle /sitemap.xml        { reverse_proxy api-server:8080 }
        handle /sitemap-images.xml { reverse_proxy api-server:8080 }
        handle /robots.txt         { reverse_proxy api-server:8080 }
        handle /feeds/*            { reverse_proxy api-server:8080 }

        handle {
                @sw     path /sw.js
                header  @sw Cache-Control "no-cache, no-store, must-revalidate"

                @hashed path /assets/*
                header  @hashed Cache-Control "public, max-age=31536000, immutable"

                root    * /srv/dr-tea
                try_files {path} /index.html
                file_server
        }
}
