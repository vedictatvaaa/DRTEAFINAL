# Optional: systemd unit as an alternative to PM2.
# Enable with:
#   sudo cp deploy/systemd/drtea-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now drtea-api
#   sudo journalctl -u drtea-api -f

[Unit]
Description=Dr Tea API server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=drtea
Group=drtea
WorkingDirectory=/var/www/drtea-app
EnvironmentFile=/var/www/drtea-app/.env
ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=append:/var/log/drtea/api-out.log
StandardError=append:/var/log/drtea/api-err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
