# Auto-HTTPS via Let's Encrypt. DOMAIN and ACME_EMAIL come from .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# Redirect www → apex
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	# API + SEO assets are served by the Node API server
	handle /api/* {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For  {remote}
			header_up Host             {host}
		}
	}
	handle /sitemap.xml        { reverse_proxy api-server:8080 }
	handle /sitemap-images.xml { reverse_proxy api-server:8080 }
	handle /robots.txt         { reverse_proxy api-server:8080 }
	handle /feeds/*            { reverse_proxy api-server:8080 }

	# Static SPA — cache-bust hashed assets, never cache the service worker
	handle {
		@sw     path /sw.js
		header  @sw Cache-Control "no-cache, no-store, must-revalidate"

		@hashed path /assets/*
		header  @hashed Cache-Control "public, max-age=31536000, immutable"

		root    * /srv/dr-tea
		try_files {path} /index.html
		file_server
	}
}
