# Copy this file to /var/www/drtea-app/.env on the VPS and fill in real values.
# PM2 will read it via `node --env-file=.env` (Node 20+) or `dotenv` if you prefer.
# NEVER commit the real .env to git.

# ---- Required ----
NODE_ENV=production
PORT=8080

# Local Postgres on the VPS (default Hostinger Ubuntu install)
DATABASE_URL=postgresql://drtea:STRONG_PASSWORD_HERE@127.0.0.1:5432/drtea

# Long, random string. Generate with: openssl rand -hex 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Admin login password for /admin (leave blank to disable admin)
ADMIN_PASSWORD=replace-me-with-a-long-random-string

# Public site base used for canonical URLs, sitemaps, JSON-LD
PUBLIC_STORE_BASE=https://drtea.in
PUBLIC_API_BASE=https://drtea.in

# Comma-separated list of origins allowed to send credentialed requests.
# Same-origin (drtea.in serving both static + /api) needs no entry.
ADMIN_ALLOWED_ORIGINS=

# ---- Object storage (Replit App Storage) ----
# Leave blank if you are running on the VPS only and storing uploads on disk.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=hello@drtea.in

# ---- Shiprocket (order fulfilment) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary

# ---- Web Push notifications ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Payment gateways (enable only the one you use) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=

# ---- AI integrations (optional, used by content/recipe/teapedia crons) ----
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Google PageSpeed Insights API key (for /admin SEO panel)
PSI_API_KEY=
