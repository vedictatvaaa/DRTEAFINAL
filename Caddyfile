:80 {
	encode gzip

	# Backend routes — handled first, terminate here.
	# Mirrors deploy/nginx/drtea.in.conf.
	handle /api/* {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote}
			header_up Host {host}
		}
	}
	handle /sitemap.xml {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}
	handle /sitemap-images.xml {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}
	handle /robots.txt {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}
	handle /feeds/* {
		reverse_proxy api-server:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	# Static SPA + fallback. Caches and SPA-fallback only run here.
	handle {
		@sw path /sw.js
		header @sw Cache-Control "no-cache, no-store, must-revalidate"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		root * /srv/dr-tea
		try_files {path} /index.html
		file_server
	}
}
